# .NET 构建产物
bin/
obj/
*.dll
*.pdb
*.exe

# NuGet
*.nupkg
*.snupkg
.nuget/

# Visual Studio / Rider / VSCode
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs

# 测试结果
TestResults/
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.coveragexml

# 日志
*.log
logs/

# 操作系统
Thumbs.db
.Desktop
.DS_Store

# Trae 文档（计划文件，不提交）
.trae/

# 前端依赖与构建产物
# 全仓采用根 pnpm 工作区（pnpm-workspace.yaml），依赖统一安装在根 node_modules，
# 各前端工程的 dist 属于构建产物，由 wails3 build / dotnet build 生成，不入库。
node_modules/
dist/
.vite/

# TypeScript 增量构建缓存
*.tsbuildinfo
**/dist-tsbuildinfo/

# 非 pnpm 的锁文件（本仓统一使用 pnpm，pnpm-lock.yaml 需要入库）
package-lock.json
yarn.lock

# CI/CD 构建产物（保留 artifacts/nupkg/.gitkeep 占位符，确保 CI 还原时
# 本地 NuGet 源目录 artifacts/nupkg 始终存在，避免 NU1301 “源目录不存在”）
artifacts/*
!artifacts/nupkg/
artifacts/nupkg/*
!artifacts/nupkg/.gitkeep

.fake

# 临时诊断/调试文件
.tmp/
*.binlog