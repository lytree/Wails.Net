# .NET 构建产物
bin/
obj/
*.dll
*.pdb
*.exe

# NuGet
*.nupkg
*.snupkg
.nuget/

# Visual Studio / Rider / VSCode
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs

# 测试结果
TestResults/
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.coveragexml

# 日志
*.log
logs/

# 操作系统
Thumbs.db
.Desktop
.DS_Store

# Trae 文档（计划文件，不提交）
.trae/

# 前端构建产物与依赖
/examples/Wails.Net.Demo.React/frontend/node_modules/
/examples/Wails.Net.Demo.React/frontend/dist/
/examples/Wails.Net.Demo.Vue/frontend/node_modules/
/examples/Wails.Net.Demo.Vue/frontend/dist/
/examples/LyboxApp/frontend/node_modules/
/examples/LyboxApp/frontend/dist/

# TypeScript 增量构建缓存
*.tsbuildinfo
**/dist-tsbuildinfo/

# npm 锁文件（使用 pnpm，pnpm-lock.yaml 会被跟踪）
package-lock.json

# CI/CD 构建产物（保留 artifacts/nupkg/.gitkeep 占位符，确保 CI 还原时
# 本地 NuGet 源目录 artifacts/nupkg 始终存在，避免 NU1301 “源目录不存在”）
artifacts/*
!artifacts/nupkg/
artifacts/nupkg/*
!artifacts/nupkg/.gitkeep

.fake

# 临时诊断/调试文件
.tmp/
*.binlog