{
  "$schema": "https://wails.net/schema/wails.json",
  "name": "Wails.Net.Demo.Updater",
  "version": "1.0.0",
  "author": {
    "name": "Wails.Net",
    "email": "demo@example.com"
  },
  "description": "Wails.Net 框架示例：更新服务。",

  "outputFilename": "Wails.Net.Demo.Updater",
  "assetDir": "frontend",

  "frontend": {
    "dir": "frontend",
    "devServerUrl": "http://localhost:5173",
    "installCommand": "echo \"Demo 使用纯 HTML/CSS/JS，无需安装前端依赖\"",
    "buildCommand": "echo \"Demo 使用纯 HTML/CSS/JS，无需前端构建\"",
    "outputDir": "."
  },

  "bindings": {
    "outputDir": "frontend/src/wails"
  },

  "wailsJsDir": "frontend",

  "bundle": {
    "identifier": "io.wailsnet.demo.updater",
    "iconPath": "build/icons",
    "category": "Developer Tools",
    "shortDescription": "Wails.Net Demo — Updater",
    "longDescription": "演示 Wails.Net 的 更新服务。",
    "copyright": "Copyright © 2026 Wails.Net",
    "windows": {
      "publisher": "Wails.Net",
      "webviewInstallMode": true
    },
    "linux": {
      "maintainer": "Wails.Net <demo@example.com>",
      "debDependencies": [
        "libwebkit2gtk-4.1-0",
        "libgtk-3-0"
      ],
      "rpmDependencies": [
        "webkit2gtk3",
        "gtk3"
      ]
    }
  },

  "beforeBuildCommand": "echo \"[hook] 开始构建 Wails.Net.Demo.Updater\"",
  "afterBuildCommand": "echo \"[hook] Wails.Net.Demo.Updater 构建完成\"",
  "beforeDevCommand": "echo \"[hook] 启动开发模式\"",
  "afterDevCommand": "echo \"[hook] 开发模式已退出\""
}
