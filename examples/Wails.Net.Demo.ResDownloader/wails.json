{
  "$schema": "https://wails.net/schema/wails.json",
  "name": "Wails.Net.Demo.ResDownloader",
  "version": "1.0.0",
  "author": {
    "name": "Wails.Net",
    "email": "demo@example.com"
  },
  "description": "Wails.Net 框架示例：本地 MITM 代理资源嗅探下载器（对标 res-downloader）。",

  "outputFilename": "Wails.Net.Demo.ResDownloader",
  "assetDir": "frontend",

  "frontend": {
    "dir": "frontend",
    "devServerUrl": "http://localhost:5173",
    "installCommand": "echo \"Demo 使用纯 HTML/CSS/JS，无需安装前端依赖\"",
    "buildCommand": "echo \"Demo 使用纯 HTML/CSS/JS，无需前端构建\"",
    "outputDir": "."
  },

  "bindings": {
    "outputDir": "frontend/src/wails"
  },

  "wailsJsDir": "frontend",

  "bundle": {
    "identifier": "io.wailsnet.demo.resdownloader",
    "iconPath": "build/icons",
    "category": "Developer Tools",
    "shortDescription": "Wails.Net Demo — 资源嗅探下载器",
    "longDescription": "通过本地 MITM 代理嗅探网页/小程序/短视频平台中的视频、音频、图片与 m3u8 流并下载。",
    "copyright": "Copyright © 2026 Wails.Net",
    "windows": {
      "publisher": "Wails.Net",
      "webviewInstallMode": true
    },
    "linux": {
      "maintainer": "Wails.Net <demo@example.com>",
      "debDependencies": [
        "libwebkit2gtk-4.1-0",
        "libgtk-3-0"
      ],
      "rpmDependencies": [
        "webkit2gtk3",
        "gtk3"
      ]
    }
  },

  "beforeBuildCommand": "echo \"[hook] 开始构建 Wails.Net.Demo.ResDownloader\"",
  "afterBuildCommand": "echo \"[hook] Wails.Net.Demo.ResDownloader 构建完成\"",
  "beforeDevCommand": "echo \"[hook] 启动开发模式\"",
  "afterDevCommand": "echo \"[hook] 开发模式已退出\""
}
