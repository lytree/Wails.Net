<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <UseWPF>false</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Wails.Net.Demo.ResDownloader</RootNamespace>
    <AssemblyName>Wails.Net.Demo.ResDownloader</AssemblyName>
    <!--
      纯 HTML/CSS/JS 前端（无 vite/package.json），跳过 SDK 的 pnpm 前端构建目标。
      该属性只在通过 NuGet 引用 SDK 时生效（buildTransitive 目标），
      与 examples/Wails.Net.Demo.Events 的静态前端做法保持一致。
    -->
    <WailsNetSkipFrontendBuild>true</WailsNetSkipFrontendBuild>
    <!-- 运行时需要生成根证书并写入证书存储，不使用增量编译标记文件以外的特殊配置 -->
  </PropertyGroup>
  <!-- Windows TFM 专用属性 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <!-- Linux TFM 专用属性 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="frontend\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!--
    通过 NuGet 包引用 Wails.Net，而不是直接引用仓库内的本地项目：
      - 版本由 Directory.Packages.props（CPM）统一控制，避免各示例版本漂移；
      - 依赖来自 artifacts/nupkg 本地源或 nuget.org，等同于外部消费者视角，
        能真实校验“打包后的 SDK 是否可用”（源生成器 analyzer、buildTransitive 目标等）。
    本地源未填充时先执行：bash scripts/pack-and-test.sh（或 dotnet pack src/Wails.Net.Sdk）。
  -->
  <ItemGroup>
    <PackageReference Include="Wails.Net.Sdk" />
  </ItemGroup>
</Project>
