<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <UseWPF>false</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Wails.Net.Demo</RootNamespace>
    <AssemblyName>Wails.Net.Demo</AssemblyName>
  </PropertyGroup>
  <!-- Windows TFM 专用属性 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <!-- Linux TFM 专用属性：WSL 调试器仅支持 Exe（控制台），WinExe 会报"项目不知道如何运行" -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <!-- 公共引用 -->
  <!-- Windows TFM 条件引用 -->
  <!-- Linux TFM 条件引用 -->
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="frontend\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Wails.Net.Sdk\Wails.Net.Sdk.csproj" />
    <!-- M1：Updater 已拆分为独立插件包（双包模型示范） -->
    <ProjectReference Include="..\..\src\Wails.Net.Plugins.Updater\Wails.Net.Plugins.Updater.csproj" />
    <!-- M3：Store 插件包 -->
    <ProjectReference Include="..\..\src\Wails.Net.Plugins.Store\Wails.Net.Plugins.Store.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- M3: OsInfo/AppInfo/Path 插件包 -->
    <ProjectReference Include="..\..\src\Wails.Net.Plugins.Osinfo\Wails.Net.Plugins.Osinfo.csproj" />
    <ProjectReference Include="..\..\src\Wails.Net.Plugins.Appinfo\Wails.Net.Plugins.Appinfo.csproj" />
    <ProjectReference Include="..\..\src\Wails.Net.Plugins.Path\Wails.Net.Plugins.Path.csproj" />
    <!-- M3: Log 插件包 -->
    <ProjectReference Include="..\..\src\Wails.Net.Plugins.Log\Wails.Net.Plugins.Log.csproj" />
    <!-- M3: 窗口组插件包 -->
    <ProjectReference Include="..\..\src\Wails.Net.Plugins.Window\Wails.Net.Plugins.Window.csproj" />
    <ProjectReference Include="..\..\src\Wails.Net.Plugins.Windows\Wails.Net.Plugins.Windows.csproj" />
    <ProjectReference Include="..\..\src\Wails.Net.Plugins.Screen\Wails.Net.Plugins.Screen.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- M3: UI 组插件包 -->
    <ProjectReference Include="..\..\src\Wails.Net.Plugins.Dialog\Wails.Net.Plugins.Dialog.csproj" />
    <ProjectReference Include="..\..\src\Wails.Net.Plugins.Notification\Wails.Net.Plugins.Notification.csproj" />
    <ProjectReference Include="..\..\src\Wails.Net.Plugins.Clipboard\Wails.Net.Plugins.Clipboard.csproj" />
    <ProjectReference Include="..\..\src\Wails.Net.Plugins.Menu\Wails.Net.Plugins.Menu.csproj" />
    <ProjectReference Include="..\..\src\Wails.Net.Plugins.Tray\Wails.Net.Plugins.Tray.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- M3: 系统组插件包 -->
    <ProjectReference Include="..\..\src\Wails.Net.Plugins.Application\Wails.Net.Plugins.Application.csproj" />
  </ItemGroup>
</Project>