<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.config
  本仓库的 NuGet 配置。

  - 注册本地包源 artifacts/nupkg/，用于 SDK 改造后的 Demo 测试。
    当 Demo 通过 PackageReference 引用 Wails.Net.Sdk 等包时，NuGet 会从此目录解析。
    运行 `dotnet pack` 时将生成的 .nupkg 输出到 artifacts/nupkg/（见 Directory.Build.props 的 PackageOutputPath）。

  - artifacts/nupkg/ 目录由仓库内的 .gitkeep 占位符保证始终存在（已加入 .gitignore 例外），
    因此 CI 还原时该本地源目录一定存在，不会因“源目录不存在”而报 NU1301。
    当前仓库内 Demo 通过 ProjectReference 从源码引用 Wails.Net，不依赖此本地源；
    本地如需用 PackageReference 测试已打包的 nupkg，先执行 `dotnet pack` 填充该目录即可。

  - 保留官方 nuget.org 源用于第三方依赖。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Wails.Net.Local" value="artifacts/nupkg" />
  </packageSources>
</configuration>
