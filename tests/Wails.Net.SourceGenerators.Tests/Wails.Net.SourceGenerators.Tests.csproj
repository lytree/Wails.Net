<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- TUnit 使用 Microsoft.Testing.Platform (MTP) 运行器 -->
    <EnableMSTestRunner>false</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="TUnit.Assertions" />
    <PackageReference Include="TUnit.Engine" />
    <!-- 驱动 CSharpGeneratorDriver 所需（仓库缓存已有 4.14.0，离线可用） -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- 正常引用：测试代码中 new BindingSourceGenerator() 实例化生成器 -->
    <ProjectReference Include="..\..\src\Wails.Net.SourceGenerators\Wails.Net.SourceGenerators.csproj" />
    <!-- 提供 [Binding]/[Command] 真实特性与生成代码引用的 GeneratedBindingRegistry/ICommandContext 等类型 -->
    <ProjectReference Include="..\..\src\Wails.Net.Application\Wails.Net.Application.csproj" />
  </ItemGroup>

  <!--
    说明：本项目手动用 CSharpGeneratorDriver 驱动 BindingSourceGenerator（对标 testing-strategy.md §4.2）。
    离线环境无法恢复 Verify.TUnit 与 Basic.Reference.Assemblies.*（仓库 NuGet 缓存无此二包），
    故采用：① 引用集用 TRUSTED_PLATFORM_ASSEMBLIES + Wails.Net.Application 本地依赖（替代 Basic.Reference.Assemblies）；
            ② 快照用「结构化断言 + 确定性 + 语法有效性 + 增量性」替代 Verify.TUnit 全文快照。
    若后续接入网络，可平滑替换为 Verify.TUnit。
  -->

</Project>
