<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Wails.Net.Plugins.Notification</PackageId>
    <Description>Wails.Net Notification 插件（前后端一体双包）</Description>
    <!--
      Android 通知需要 Android.* API：默认仅编译 net10.0（进程调用方案）；
      -p:WailsNetEnableAndroid=true 时追加 net10.0-android36.0（需 android 工作负载）。
    -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(WailsNetEnableAndroid)' == 'true'">net10.0;net10.0-android36.0</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('android'))">24</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    android 目标不要手写 [assembly: SupportedOSPlatform("android")]：
    TFM 为 net10.0-android36.0 时 SDK 会按 SupportedOSPlatformVersion 自动生成带版本的
    属性，手写无版本号的那条会把 CA1416 上下文降级为「所有版本」，反而误报平台兼容性。
  -->

  <ItemGroup>
    <ProjectReference Include="..\Wails.Net.Application\Wails.Net.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wails.Net.Application.Tests" />
  </ItemGroup>

</Project>