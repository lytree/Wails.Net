<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Company.AppName</RootNamespace>
    <AssemblyName>Company.AppName</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!--
      SDK-3：统一 SDK 单包引用。
      仅引用 Wails.Net.Sdk，NuGet 依据 TargetFramework 自动解析对应平台 Bundle 包
      （net10.0-windows10.0.19041.0 → Wails.Net.Bundle.Windows）。
      Wails.Net.Sdk 的 buildTransitive props 依据 RuntimeIdentifier / WailsNetPlatform
      自动选择平台实现，Program.cs 无需条件编译（统一 UseWailsPlatform()）。
    -->
    <PackageReference Include="Wails.Net.Sdk" />
    <!-- M3：内置插件已拆分为独立包，模板按需引用 -->
    <PackageReference Include="Wails.Net.Plugins.OsInfo" />
    <PackageReference Include="Wails.Net.Plugins.Log" />
    <PackageReference Include="Wails.Net.Plugins.Window" />
    <PackageReference Include="Wails.Net.Plugins.Application" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="capabilities\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="frontend\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>