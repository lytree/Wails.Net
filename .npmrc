# pnpm 工作区配置
#
# link-workspace-packages：示例前端引用 @wails-net/runtime 时优先链接工作区内的本地包
# prefer-workspace-packages：即使 registry 上存在同名版本也优先用工作区版本
link-workspace-packages=true
prefer-workspace-packages=true

# 严格 peer 依赖会让示例安装频繁失败，示例工程放宽处理
strict-peer-dependencies=false

# esbuild 需要执行 postinstall 下载平台二进制
only-built-dependencies[]=esbuild
